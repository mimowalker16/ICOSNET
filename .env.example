# Copy this file to .env and fill in the values

SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=icosnet
DB_USER=icosnet
DB_PASSWORD=icosnet
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Email (SMTP) — fill in when provided by ICOSNET IT
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=supervision@icosnet.dz

# Slack/Teams webhooks — fill in when provided
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# CORS — add frontend origin in production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
